<controls:WidgetViewBase
    x:Class="Widgets.App.Widgets.CountdownWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Widgets.App.Controls">

    <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock
            x:Name="TitleText"
            HorizontalAlignment="Center"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis" />

        <Viewbox x:Name="ValueBox" Stretch="Uniform" StretchDirection="DownOnly">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock x:Name="ValueText" VerticalAlignment="Bottom" />
                <TextBlock x:Name="UnitText" VerticalAlignment="Bottom" Margin="3,0,0,0" />
            </StackPanel>
        </Viewbox>

        <TextBlock
            x:Name="TargetText"
            HorizontalAlignment="Center"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis" />
    </StackPanel>

</controls:WidgetViewBase>
