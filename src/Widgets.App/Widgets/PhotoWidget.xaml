<controls:WidgetViewBase
    x:Class="Widgets.App.Widgets.PhotoWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Widgets.App.Controls">

    <Grid>
        <Image x:Name="ImageA" Opacity="0" />
        <Image x:Name="ImageB" Opacity="0" />

        <StackPanel
            x:Name="EmptyState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="Collapsed">
            <TextBlock x:Name="EmptyGlyph" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>

</controls:WidgetViewBase>
