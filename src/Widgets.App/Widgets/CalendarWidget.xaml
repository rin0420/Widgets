<controls:WidgetViewBase
    x:Class="Widgets.App.Widgets.CalendarWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Widgets.App.Controls">

    <Grid RowSpacing="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="TitleText"
            HorizontalAlignment="Center"
            TextTrimming="CharacterEllipsis" />

        <Grid x:Name="Days" Grid.Row="1" />
    </Grid>

</controls:WidgetViewBase>
