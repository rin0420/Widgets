<controls:WidgetViewBase
    x:Class="Widgets.App.Widgets.DigitalClockWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Widgets.App.Controls">

    <StackPanel VerticalAlignment="Center" Spacing="2">
        <Viewbox
            x:Name="TimeBox"
            Stretch="Uniform"
            StretchDirection="DownOnly">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock x:Name="TimeText" VerticalAlignment="Bottom" />
                <TextBlock x:Name="SecondsText" VerticalAlignment="Bottom" Margin="4,0,0,0" />
            </StackPanel>
        </Viewbox>

        <TextBlock
            x:Name="DateText"
            HorizontalAlignment="Center"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis" />
    </StackPanel>

</controls:WidgetViewBase>
