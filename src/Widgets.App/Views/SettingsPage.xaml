<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Widgets.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="設定" Style="{StaticResource PageTitleTextStyle}" />

        <InfoBar x:Name="InfoBarControl" Grid.Row="1" Margin="0,12,0,0" IsOpen="False" />

        <ScrollViewer Grid.Row="2" Margin="0,8,0,0" Padding="0,0,8,0">
            <StackPanel Spacing="4" MaxWidth="820" HorizontalAlignment="Left" Padding="0,0,0,24">

                <Expander Header="全般" IsExpanded="True" Style="{StaticResource SectionExpanderStyle}">
                    <StackPanel Spacing="14" Padding="0,4,0,4">
                        <ToggleSwitch x:Name="StartupToggle" Header="Windows へのサインイン時に起動"
                                      OnContent="オン" OffContent="オフ" Toggled="OnStartupToggled" />
                        <ToggleSwitch x:Name="StartMinimizedToggle" Header="起動時はこのウィンドウを表示しない"
                                      OnContent="オン" OffContent="オフ" Toggled="OnStartMinimizedToggled" />
                        <ComboBox x:Name="AppThemeCombo" Header="アプリの外観" Width="260"
                                  SelectionChanged="OnAppThemeChanged" />
                    </StackPanel>
                </Expander>

                <Expander Header="フレームレート計測" IsExpanded="True" Style="{StaticResource SectionExpanderStyle}">
                    <StackPanel Spacing="14" Padding="0,4,0,4">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"
                                   Text="ゲームなど前面アプリの実 FPS は Windows の ETW から読み取ります。ETW セッションの作成には管理者権限が必要で、権限が無いときはデスクトップ全体の描画レートに切り替わります。" />
                        <TextBlock x:Name="FrameRateStatusText" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <Button x:Name="ElevateButton" Content="管理者として再起動" Click="OnElevateClick" />
                    </StackPanel>
                </Expander>

                <Expander Header="ウィジェットの配置" IsExpanded="True" Style="{StaticResource SectionExpanderStyle}">
                    <StackPanel Spacing="14" Padding="0,4,0,4">
                        <ComboBox x:Name="SnapCombo" Header="スナップ" Width="260"
                                  SelectionChanged="OnSnapChanged" />
                        <Slider x:Name="GridSizeSlider" Header="グリッドの間隔" Minimum="4" Maximum="64"
                                StepFrequency="2" Width="320" ValueChanged="OnGridSizeChanged" />
                        <ToggleSwitch x:Name="LockAllToggle" Header="すべてのウィジェットを固定"
                                      OnContent="オン" OffContent="オフ" Toggled="OnLockAllToggled" />
                        <ToggleSwitch x:Name="HideOnFullscreenToggle" Header="全画面表示中は隠す"
                                      OnContent="オン" OffContent="オフ" Toggled="OnHideOnFullscreenToggled" />
                        <Button Content="すべてのウィジェットを再読み込み" Click="OnReloadWidgetsClick" />
                    </StackPanel>
                </Expander>

                <Expander Header="デスクトップの背景" Style="{StaticResource SectionExpanderStyle}">
                    <StackPanel Spacing="14" Padding="0,4,0,4">
                        <TextBlock Text="透過するウィジェットの背景に使う、現在のデスクトップ画像を取り込み直します。"
                                   Style="{StaticResource CaptionTextStyle}" />
                        <Button x:Name="WallpaperRefreshButton" Content="デスクトップの背景を再取得"
                                Click="OnRefreshWallpaperClick" />
                        <ToggleSwitch x:Name="FollowAnimatedWallpaperToggle" Header="アニメーション壁紙に追従する"
                                      OnContent="オン" OffContent="オフ" Toggled="OnFollowAnimatedWallpaperToggled" />
                        <TextBlock Text="5 秒ごとにデスクトップを取り込み直します。CPU の使用率が上がります。"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Expander>

                <Expander Header="天気と場所" Style="{StaticResource SectionExpanderStyle}">
                    <StackPanel Spacing="14" Padding="0,4,0,4">
                        <ToggleSwitch x:Name="MetricToggle" Header="温度の単位"
                                      OnContent="摂氏 (°C)" OffContent="華氏 (°F)" Toggled="OnMetricToggled" />
                        <TextBlock x:Name="LocationText" Style="{StaticResource CaptionTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="LocationQueryBox" PlaceholderText="都市名を入力" Width="260"
                                     KeyDown="OnLocationQueryKeyDown" />
                            <Button x:Name="LocationSearchButton" Content="検索" Click="OnLocationSearchClick" />
                            <Button x:Name="LocationDetectButton" Content="現在地を取得" Click="OnLocationDetectClick" />
                        </StackPanel>
                        <ListView x:Name="LocationResults" MaxHeight="200" Visibility="Collapsed"
                                  SelectionMode="Single" SelectionChanged="OnLocationSelected" />
                    </StackPanel>
                </Expander>

                <Expander Header="保存した色" Style="{StaticResource SectionExpanderStyle}">
                    <StackPanel Spacing="14" Padding="0,4,0,4">
                        <StackPanel x:Name="SavedColorsPanel" Orientation="Horizontal" Spacing="8" />
                        <Button Content="保存した色をすべて削除" Click="OnClearSavedColorsClick" />
                    </StackPanel>
                </Expander>

                <Expander Header="データと診断" Style="{StaticResource SectionExpanderStyle}">
                    <StackPanel Spacing="14" Padding="0,4,0,4">
                        <TextBlock x:Name="DataPathText" IsTextSelectionEnabled="True"
                                   Style="{StaticResource CaptionTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="データフォルダーを開く" Click="OnOpenDataFolderClick" />
                            <HyperlinkButton x:Name="CrashLogLink" Content="クラッシュログを開く"
                                             Click="OnOpenCrashLogClick" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Header="アプリ" Style="{StaticResource SectionExpanderStyle}">
                    <StackPanel Spacing="14" Padding="0,4,0,4">
                        <TextBlock Text="終了するとデスクトップ上のウィジェットもすべて閉じられます。"
                                   Style="{StaticResource CaptionTextStyle}" />
                        <Button Content="アプリを終了" Click="OnExitClick" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
