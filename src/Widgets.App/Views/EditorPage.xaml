<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Widgets.App.Views.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="440" />
        </Grid.ColumnDefinitions>

        <!-- Left: live preview -->
        <Grid Padding="24,16,16,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Click="OnBackClick" ToolTipService.ToolTip="マイウィジェットへ戻る"
                        Width="40" Height="40" Padding="0">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitleTextStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <RadioButtons x:Name="SizeSelector" MaxColumns="5"
                              SelectionChanged="OnSizeSelectorChanged" />

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Bottom"
                            HorizontalAlignment="Right" Margin="12,0,0,0">
                    <TextBlock x:Name="PreviewSizeText" HorizontalAlignment="Right"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SizeHintText" HorizontalAlignment="Right"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Grid>

            <Border x:Name="PreviewBackdrop" Grid.Row="2" Margin="0,12,0,0"
                    CornerRadius="12"
                    Background="{StaticResource PreviewBackdropBrush}"
                    SizeChanged="OnPreviewBackdropSizeChanged">
                <Grid x:Name="PreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Right: settings -->
        <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <InfoBar x:Name="ErrorBar" Margin="16,16,16,0" IsOpen="False" Severity="Error" />

            <ScrollViewer Grid.Row="1" Padding="16,16,8,16">
                <StackPanel Spacing="4">

                    <Expander Header="基本" IsExpanded="True" Style="{StaticResource SectionExpanderStyle}">
                        <StackPanel Spacing="14" Padding="0,4,0,4">
                            <TextBox x:Name="NameBox" Header="名前" TextChanged="OnNameChanged" />
                            <ComboBox x:Name="SizeCombo" Header="サイズ" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnSizeComboChanged" />
                            <Slider x:Name="ScaleSlider" Header="拡大率" ValueChanged="OnScaleChanged" />
                            <ComboBox x:Name="ZOrderCombo" Header="重なり順" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnZOrderChanged" />
                            <ToggleSwitch x:Name="ClickThroughToggle" Header="クリックをすり抜ける"
                                          OnContent="オン" OffContent="オフ" Toggled="OnClickThroughToggled" />
                            <ToggleSwitch x:Name="LockToggle" Header="位置を固定"
                                          OnContent="オン" OffContent="オフ" Toggled="OnLockToggled" />
                            <ToggleSwitch x:Name="VisibleToggle" Header="デスクトップに表示"
                                          OnContent="表示" OffContent="非表示" Toggled="OnVisibleToggled" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="コンテンツ" IsExpanded="True" Style="{StaticResource SectionExpanderStyle}">
                        <StackPanel x:Name="ContentPanel" Spacing="14" Padding="0,4,0,4" />
                    </Expander>

                    <Expander Header="外観" Style="{StaticResource SectionExpanderStyle}">
                        <StackPanel Spacing="14" Padding="0,4,0,4">
                            <ComboBox x:Name="FontCombo" Header="フォント" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnFontChanged" />
                            <Slider x:Name="FontScaleSlider" Header="文字の大きさ" ValueChanged="OnFontScaleChanged" />
                            <ComboBox x:Name="FontWeightCombo" Header="文字の太さ" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnFontWeightChanged" />

                            <TextBlock Text="色" Style="{StaticResource FieldLabelTextStyle}" />
                            <StackPanel x:Name="ColorRowsPanel" Spacing="8" />

                            <Slider x:Name="BorderThicknessSlider" Header="枠線の太さ" Minimum="0" Maximum="8"
                                    StepFrequency="0.5" ValueChanged="OnBorderThicknessChanged" />
                            <Slider x:Name="CornerRadiusSlider" Header="角の丸み" Minimum="0" Maximum="48"
                                    StepFrequency="1" ValueChanged="OnCornerRadiusChanged" />
                            <Slider x:Name="PaddingSlider" Header="内側の余白" Minimum="0" Maximum="48"
                                    StepFrequency="1" ValueChanged="OnPaddingChanged" />
                            <Slider x:Name="OpacitySlider" Header="不透明度" ValueChanged="OnOpacityChanged" />

                            <ComboBox x:Name="BackdropCombo" Header="背景" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnBackdropChanged" />

                            <StackPanel x:Name="BackgroundImageRow" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="背景画像" Style="{StaticResource FieldLabelTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="画像を選ぶ" Click="OnPickBackgroundImageClick" />
                                    <Button Content="クリア" Click="OnClearBackgroundImageClick" />
                                </StackPanel>
                                <TextBlock x:Name="BackgroundImageText" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CaptionTextStyle}" />
                                <Slider x:Name="BackgroundImageOpacitySlider" Header="背景画像の不透明度"
                                        ValueChanged="OnBackgroundImageOpacityChanged" />
                            </StackPanel>

                            <ToggleSwitch x:Name="ShadowToggle" Header="影を付ける"
                                          OnContent="オン" OffContent="オフ" Toggled="OnShadowToggled" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="時間帯ウィジェット" Style="{StaticResource SectionExpanderStyle}">
                        <StackPanel Spacing="12" Padding="0,4,0,4">
                            <TextBlock TextWrapping="Wrap"
                                       Text="指定した時間帯だけ別の種類のウィジェットに切り替わります。重なった場合は上の行が優先されます。"
                                       Style="{StaticResource CaptionTextStyle}" />
                            <StackPanel x:Name="TimedPanel" Spacing="8" />
                            <Button Click="OnAddTimedSlotClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="時間帯を追加" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Expander>

                    <Expander Header="プリセット" Style="{StaticResource SectionExpanderStyle}">
                        <StackPanel Spacing="12" Padding="0,4,0,4">
                            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PresetStrip" Orientation="Horizontal" Spacing="8"
                                            Padding="0,0,0,8" />
                            </ScrollViewer>
                            <Button Content="現在のデザインを保存" Click="OnSavePresetClick" />
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Spacing="8" Padding="16">
                <Button Content="元に戻す" Click="OnRevertClick" />
                <Button Content="完了" Style="{StaticResource AccentButtonStyle}" Click="OnDoneClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
