<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Widgets.App.Views.MyWidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="マイウィジェット" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <Button Grid.Column="1" VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnAddClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="ウィジェットを追加" />
                </StackPanel>
            </Button>
        </Grid>

        <GridView
            x:Name="CardsView"
            Grid.Row="1"
            Margin="0,16,0,0"
            Padding="0,0,0,24"
            ItemsSource="{x:Bind Cards}"
            SelectionMode="None"
            IsItemClickEnabled="False">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            MaxWidth="380">
            <Border Width="96" Height="96" CornerRadius="24" HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <FontIcon Glyph="&#xE8A9;" FontSize="40"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
            <TextBlock Text="まだウィジェットがありません"
                       HorizontalAlignment="Center"
                       FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="ギャラリーからお気に入りのウィジェットを選んで、デスクトップに配置しましょう。"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextStyle}" />
            <Button Content="ウィジェットを追加"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnAddClick" />
        </StackPanel>
    </Grid>
</Page>
