<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Widgets.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Required by [LibraryImport] source generation and the WinRT COM interop in the host windows. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Widgets</AssemblyName>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0-beta</InformationalVersion>
    <Product>Widgets</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SelfContained>true</SelfContained>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <DefaultLanguage>ja-JP</DefaultLanguage>
    <NoWarn>$(NoWarn);CS1591;NETSDK1206</NoWarn>

    <!-- This sits in the tray all day, so footprint matters more than allocation throughput.
         Workstation GC is already the default, but background GC keeps a spare heap and a thread
         alive purely to shorten pauses nobody can see in a widget. TieredPGO's instrumentation
         is likewise not worth its memory here. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Trades a little GC time for a smaller heap; the sweet spot for a background app. -->
    <RuntimeHostConfigurationOption Include="System.GC.Conserve" Value="5" Trim="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250916003" />
    <!-- ETW consumer for the per-application frame rate (see FrameRateService). -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
